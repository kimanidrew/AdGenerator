# Frontend (web/.env.local only)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend (api/.env) — never commit real credentials
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# Neon PostgreSQL: pooled URL for app traffic; direct URL for migrations.
# The API normalizes postgresql:// to postgresql+psycopg:// (psycopg 3).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
MIGRATION_DATABASE_URL=

JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRE_MINUTES=60

# Optional self-hosted OpenAI-compatible LLM endpoint (e.g. Qwen served by vLLM).
# Leave SCRIPT_LLM_BASE_URL blank to use the clearly labelled starter-template generator.
# Example base URL: https://your-private-model-host.example/v1
SCRIPT_LLM_BASE_URL=
SCRIPT_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
SCRIPT_LLM_API_KEY=
SCRIPT_LLM_TIMEOUT_SECONDS=55

# Phase 3: hosted OpenAI-compatible image gateway (response must include data[0].b64_json).
# Keep GPU inference on a hosted GPU provider, never on your PC or Vercel.
IMAGE_GENERATION_BASE_URL=
IMAGE_GENERATION_MODEL=stabilityai/sdxl-turbo
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_TIMEOUT_SECONDS=180

# Upstash Redis: use the rediss:// URL, not the full "redis-cli --tls -u ..." command.
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_REDIS_HOST:6379

# Cloudflare R2: use the account S3 API endpoint, not the public *.r2.dev URL.
# Either set STORAGE_ENDPOINT to https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# or set R2_ACCOUNT_ID and let the API construct that endpoint.
STORAGE_PROVIDER=cloudflare_r2
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
STORAGE_ENDPOINT=
STORAGE_BUCKET=ads-media
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=YOUR_R2_ACCESS_KEY_ID
STORAGE_SECRET_KEY=YOUR_R2_SECRET_ACCESS_KEY

# The R2 API token string is not used by boto3; use its S3 Access Key ID
# and Secret Access Key above. Never put secrets in NEXT_PUBLIC_ variables.
