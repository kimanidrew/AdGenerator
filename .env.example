# Frontend (web/.env.local)
APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Neon PostgreSQL (use the pooled connection string for app traffic)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional: direct Neon URL for Alembic migrations, if configured separately
MIGRATION_DATABASE_URL=

# Backend authentication
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRE_MINUTES=60

# Managed Redis (use the TLS/rediss URL supplied by your provider)
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_REDIS_HOST:6379

# Cloudflare R2 (S3-compatible object storage)
STORAGE_PROVIDER=cloudflare_r2
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_BUCKET=kenyaads-media
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=YOUR_R2_ACCESS_KEY_ID
STORAGE_SECRET_KEY=YOUR_R2_SECRET_ACCESS_KEY

# Never add real credentials to this file or commit a populated .env file.
